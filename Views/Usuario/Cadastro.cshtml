@model TalentDesk.Models.Usuario

<h1>Criar conta</h1>

<form asp-controller="Usuario" asp-action="Cadastro" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Senha">Senha</label>
        <input asp-for="Senha" type="password" />
        <span asp-validation-for="Senha"></span>
    </div>

    <div>
        <label asp-for="Whatsapp">WhatsApp</label>
        <input asp-for="Whatsapp" />
        <span asp-validation-for="Whatsapp"></span>
    </div>

    <div>
        <label asp-for="DataNascimento">Data de nascimento</label>
        <input asp-for="DataNascimento" type="date" />
        <span asp-validation-for="DataNascimento"></span>
    </div>

    <div>
        <span asp-validation-summary="ModelOnly"></span>
    </div>

    <button type="submit">
        Criar conta
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}