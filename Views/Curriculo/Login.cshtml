@model TalentDesk.Models.LoginViewModel
@{
    ViewData["Title"] = "Login e cadastro";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #5b21b6;
            --primary-dark: #4c1d95;
            --primary-soft: #ede9fe;
            --bg: #f4f1ff;
            --panel: #ffffff;
            --border: #e5e7eb;
            --text: #1f1b3d;
            --muted: #6b6685;
            --danger: #dc2626;
            --success: #166534;
            --shadow: rgba(61, 37, 97, 0.1);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f4f1ff 0%, #f8f8fc 100%);
            color: var(--text);
        }

        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        .auth-layout {
            width: min(760px, 100%);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .auth-card {
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(91,33,182,0.08);
            border-radius: 28px;
            box-shadow: 0 24px 60px var(--shadow);
            padding: 32px 28px;
        }

        .brand-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            color: var(--primary);
            margin-bottom: 28px;
        }

        .brand-icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: grid;
            place-items: center;
            color: #fff;
            box-shadow: 0 14px 30px rgba(91, 33, 182, 0.22);
        }

        .brand-icon svg {
            width: 24px;
            height: 24px;
            fill: currentColor;
        }

        .brand-box h1 {
            margin: 0;
            font-size: clamp(2rem, 2vw, 2.4rem);
            font-weight: 800;
            line-height: 1.1;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .auth-header h2 {
            margin: 0 0 8px;
            font-size: clamp(1.8rem, 1.8vw, 2.3rem);
            font-weight: 800;
        }

        .auth-header p {
            margin: 0;
            font-size: 0.96rem;
            color: var(--muted);
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.8rem;
            color: var(--muted);
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .input-field {
            width: 100%;
            min-height: 48px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: #fff;
            padding: 0 14px;
            color: var(--text);
            font-size: 0.97rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .input-field:focus {
            border-color: rgba(91,33,182,0.62);
            box-shadow: 0 0 0 4px rgba(91,33,182,0.08);
        }

        .field-validation-error, .validation-summary-errors {
            display: block;
            color: var(--danger);
            font-size: 0.78rem;
            margin-top: 7px;
            font-weight: 600;
        }

        .submit-button {
            width: 100%;
            min-height: 52px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: #fff;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 14px 26px rgba(91,33,182,0.22);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .submit-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 30px rgba(91,33,182,0.26);
        }

        .secondary-link {
            margin-top: 18px;
            text-align: center;
            color: var(--muted);
            font-size: 0.92rem;
        }

        .secondary-link a {
            color: var(--primary);
            font-weight: 700;
            text-decoration: none;
        }

        .status-box {
            margin-top: 20px;
            padding: 12px 14px;
            border-radius: 12px;
            background: #ecfdf5;
            color: var(--success);
            border: 1px solid rgba(22, 101, 52, 0.18);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .switcher {
            display: flex;
            gap: 8px;
            background: var(--primary-soft);
            border-radius: 12px;
            padding: 8px;
            margin-bottom: 24px;
        }

        .switcher a {
            text-decoration: none;
            flex: 1;
            text-align: center;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .switcher a.active {
            background: var(--panel);
            box-shadow: 0 2px 8px rgba(91,33,182,0.08);
        }

        .muted-text {
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.5;
        }
    </style>
}

<style>
    @@media (max-width: 900px) {
        .auth-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="auth-shell">
    <div class="auth-layout">
        <div class="auth-card" id="cadastro">
            <div class="brand-box">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 3.5A2.5 2.5 0 0 1 9.5 1h7A2.5 2.5 0 0 1 19 3.5v13.9a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 7 17.4V3.5Zm2.5-.5a.5.5 0 0 0-.5.5v13.9c0 .28.22.5.5.5h7a.5.5 0 0 0 .5-.5V3.5a.5.5 0 0 0-.5-.5h-7Zm1.5 3h4v1.5h-4V6Zm0 3h5v1.5h-5V9Zm0 3h5v1.5h-5v-1.5Z"/>
                    </svg>
                </div>
                <h1>Talent<br />Desk</h1>
            </div>

            <div class="auth-header">
                <h2>Criar conta</h2>
                <p>cadastre-se e venha fazer parte do Talent Desk</p>
            </div>

            <form asp-controller="Usuario" asp-action="Cadastro" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Nome">Nome</label>
                    <input asp-for="Nome" class="input-field" placeholder="Digite seu nome" />
                    <span asp-validation-for="Nome" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">E-mail</label>
                    <input asp-for="Email" class="input-field" type="email" placeholder="Digite seu e-mail" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Senha">Senha</label>
                    <input asp-for="Senha" class="input-field" type="password" placeholder="Digite sua senha" />
                    <span asp-validation-for="Senha" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Whatsapp">WhatsApp</label>
                    <input asp-for="Whatsapp" class="input-field" placeholder="Digite seu WhatsApp" />
                    <span asp-validation-for="Whatsapp" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DataNascimento">Data de nascimento</label>
                    <input asp-for="DataNascimento" class="input-field" type="date" />
                    <span asp-validation-for="DataNascimento" class="field-validation-error"></span>
                </div>

                <button type="submit" class="submit-button">Criar conta</button>
            </form>

            <div class="secondary-link">
                <a asp-controller="Curriculo" asp-action="Index">Voltar para a página inicial</a>
            </div>

            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="status-box">
                    @TempData["MensagemSucesso"]
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
