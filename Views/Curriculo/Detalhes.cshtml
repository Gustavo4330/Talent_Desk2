@model TalentDesk.Models.Curriculo

@{
    ViewData["Title"] = "Detalhes do Currículo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <style>
        .details-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: var(--primary-color);
        }

        .profile-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 2.5rem;
        }

        .profile-header img {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            object-fit: cover;
            border: 4px solid #f3f4f6;
        }

        .profile-info h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }

        .profile-info .badge {
            display: inline-block;
            padding: 0.4rem 1rem;
            background: #eff6ff;
            color: var(--primary-color);
            border-radius: 2rem;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .detail-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .detail-value {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text-main);
        }

            
            .profile-card {
                padding: 1.5rem;
            }

            .details-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }
    </style>
}

<div class="details-container">
    
    <a asp-action="Index" class="back-link">
        ← Voltar para a lista
    </a>

    <div class="profile-card">
        
        <div class="profile-header">
            <img src="@Model.FotoUrl" alt="Foto de @Model.Nome" />
            <div class="profile-info">
                <h1>@Model.Nome</h1>
                <span class="badge">@Model.Area</span>
            </div>
        </div>

        <div class="details-grid">
            
            <div class="detail-item">
                <span class="detail-label">ID do Registro</span>
                <span class="detail-value">#@Model.Id</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Formação Acadêmica</span>
                <span class="detail-value">@Model.Formacao</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Idade</span>
                <span class="detail-value">@Model.Idade anos</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Status</span>
                <span class="detail-value" style="color: #10b981;">● Ativo</span>
            </div>

        </div>

    </div>

</div>
