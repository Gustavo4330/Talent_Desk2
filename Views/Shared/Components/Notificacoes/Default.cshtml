@model List<TalentDesk.Models.Curriculo>

<details class="notificacoes">
    <summary class="icon-button" aria-label="Notificações">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg>
        @if (Model.Any())
        {
            <span class="notificacoes-ponto" aria-label="@Model.Count novos"></span>
        }
    </summary>

    <div class="dropdown notificacoes-lista">
        <strong class="dropdown-titulo">Novos currículos</strong>
        @if (Model.Any())
        {
            foreach (var curriculo in Model)
            {
                <a class="notificacao" asp-controller="Curriculo" asp-action="Index" asp-route-selecionado="@curriculo.Id">
                    <span class="notificacao-texto">
                        <strong>@curriculo.Nome</strong>
                        <span>@curriculo.Cargo · @curriculo.CadastradoHa.ToLower()</span>
                    </span>
                </a>
            }
        }
        else
        {
            <p class="dropdown-vazio">Nenhum currículo novo nos últimos 7 dias.</p>
        }
    </div>
</details>
