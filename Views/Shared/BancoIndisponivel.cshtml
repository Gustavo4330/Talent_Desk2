@{
    Layout = "_Layout";
    ViewData["Title"] = "Banco de dados desligado";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
}

<div class="entrar-pagina">
    <div class="entrar-card">
        <h1>Não foi possível acessar o banco de dados</h1>
        <p class="entrar-subtitulo">O sistema não conseguiu se conectar ao MySQL.</p>

        <ol class="passos">
            <li>Abra o <strong>XAMPP Control Panel</strong>.</li>
            <li>Clique em <strong>Start</strong> na linha do <strong>MySQL</strong>.</li>
            <li>Volte aqui e recarregue a página.</li>
        </ol>

        <details class="detalhe-erro">
            <summary>Detalhes técnicos</summary>
            <code>@ViewData["Mensagem"]</code>
        </details>

        <a class="btn btn-primary btn-lg btn-bloco" href="">Tentar novamente</a>
    </div>
</div>
