<Project>
  <!--
    Gera bin/ e obj/ fora do OneDrive. A pasta do OneDrive tem uma regra de
    permissão que impede apagar arquivos, o que quebra o restore e o build.
  -->
  <PropertyGroup>
    <BuildRootOutsideOneDrive>$(LOCALAPPDATA)\Curriculo-build\</BuildRootOutsideOneDrive>
    <BaseIntermediateOutputPath>$(BuildRootOutsideOneDrive)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(BuildRootOutsideOneDrive)bin\</BaseOutputPath>
    <!-- Ignora as pastas bin/obj antigas que ficaram dentro do projeto. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
